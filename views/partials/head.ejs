<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex, nofollow" />
<%#
  pageTitle приходит вторым аргументом include:
  include('partials/head', { pageTitle: '...' }).
  Объявлять его в родителе как обычную переменную нельзя: партиал компилируется
  отдельной функцией и такую переменную не увидит, поэтому заголовок молча
  откатится к siteTitle. Без своего pageTitle страница берёт siteTitle — это нормально.
%>
<title><%= typeof pageTitle !== 'undefined' ? pageTitle : siteTitle %></title>
<meta name="description" content="Приглашение на свадьбу <%= siteTitle %>" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Montserrat:wght@300;400;500;600&display=swap"
  rel="stylesheet"
/>
<link rel="stylesheet" href="/static/css/styles.css?v=<%= assetVersion %>" />
<link
  rel="icon"
  href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💍</text></svg>"
/>
