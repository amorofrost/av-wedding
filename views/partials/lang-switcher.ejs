<%#
  Переключатель языка. Обычные ссылки без JS: middleware ловит ?lang=,
  ставит cookie и убирает параметр из адреса.
%>
<nav class="lang-switcher" aria-label="<%= t.langSwitcher.label %>">
  <% langLinks.forEach(function (l) { %>
    <a class="lang-switcher__item<%= l.active ? ' is-active' : '' %>"
      href="<%= l.href %>" lang="<%= l.code %>" title="<%= l.name %>"
      <%= l.active ? 'aria-current="true"' : '' %>><%= l.short %></a>
  <% }); %>
</nav>
