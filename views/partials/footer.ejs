<footer class="site-footer">
  <div class="footer-monogram"><%= content.couple.monogram %></div>
  <p class="footer-note"><%= content.footer.note %></p>
  <% if (content.couple.hashtag) { %>
    <p class="footer-hashtag"><%= content.couple.hashtag %></p>
  <% } %>
  <p class="footer-copy"><%= content.couple.bride %> &amp; <%= content.couple.groom %> · <%= currentYear %></p>
</footer>
