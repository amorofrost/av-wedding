<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head', { pageTitle: t.titles.error + ' ' + code }) %>
</head>
<body>
  <main class="centered-page">
    <%- include('partials/lang-switcher') %>
    <div class="card-message">
      <div class="card-message__emoji"><%= code === 404 ? '🔍' : '⚠️' %></div>
      <h1><%= code %></h1>
      <p><%= message %></p>
      <a href="/" class="btn btn--ghost"><%= t.common.backHome %></a>
    </div>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
