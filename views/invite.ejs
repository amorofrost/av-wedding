<!DOCTYPE html>
<html lang="ru">
<head>
  <%- include('partials/head', { pageTitle: 'Приглашение · ' + siteTitle }) %>
</head>
<body class="invite-page">
  <header class="hero hero--compact<%= content.couple.photoUrl ? ' hero--split' : '' %>">
    <div class="hero__inner">
      <div class="hero__text">
        <p class="hero__eyebrow">Дорогие</p>
        <h1 class="hero__names hero__names--invite"><%= invite.names %></h1>
        <p class="hero__invite-lead">
          <%= content.couple.groom %> и <%= content.couple.bride %> приглашают вас на свою свадьбу
        </p>
        <p class="hero__date"><%= content.event.dateHuman %> · <%= content.event.city %></p>
        <div class="countdown countdown--compact" data-target="<%= content.event.dateISO %>">
          <div class="countdown__cell"><span data-cd="days">—</span><small>дней</small></div>
          <div class="countdown__cell"><span data-cd="hours">—</span><small>часов</small></div>
          <div class="countdown__cell"><span data-cd="minutes">—</span><small>минут</small></div>
        </div>
      </div>

      <% if (content.couple.photoUrl) { %>
        <figure class="hero__photo" style="--photo-pos: <%= content.couple.photoPosition %>">
          <img src="<%= content.couple.photoUrl %>"
            alt="<%= content.couple.groom %> и <%= content.couple.bride %>"
            fetchpriority="high" decoding="async" />
        </figure>
      <% } %>
    </div>
  </header>

  <main class="invite-main">
    <!-- Краткие детали -->
    <section class="section">
      <!-- Площадка одна на всё торжество, поэтому здесь без фото:
           картинку в шапке уже занимает фото пары. -->
      <article class="venue venue--solo">
        <p class="venue__kicker"><%= content.venue.kicker %></p>
        <p class="venue__time">Церемония в <%= content.event.timeHuman %></p>
        <h3 class="venue__name"><%= content.venue.name %></h3>
        <p class="venue__address"><%= content.venue.address %></p>
        <% if (content.venue.mapUrl) { %>
          <a class="btn btn--ghost" href="<%= content.venue.mapUrl %>" target="_blank" rel="noopener">На карте →</a>
        <% } %>
      </article>
      <p class="invite-more">
        <a href="/#when">Смотреть расписание и все детали →</a>
      </p>
    </section>

    <!-- Форма RSVP -->
    <section id="rsvp" class="section section--tint rsvp-section">
      <h2 class="section__title">Ваш ответ</h2>

      <% if (saved) { %>
        <div class="alert alert--success">
          <p>Спасибо! Ваш ответ сохранён.</p>
          <% if (invite.attending === true) { %>
            <p>Будем очень рады видеть вас — <strong><%= invite.guestCount %></strong>
              <%= invite.guestCount === 1 ? 'гость' : (invite.guestCount < 5 ? 'гостя' : 'гостей') %>.
              Ответ можно изменить в любой момент до <%= content.rsvpDeadline.dateHuman %>.</p>
          <% } else { %>
            <p>Жаль, что не сможете быть с нами. Если планы изменятся — просто ответьте снова.</p>
          <% } %>
        </div>
      <% } %>

      <% if (error) { %>
        <div class="alert alert--error"><p><%= error %></p></div>
      <% } %>

      <% if (invite.responded && !saved) { %>
        <div class="alert alert--info">
          <p>Вы уже ответили<%= invite.attending ? ' — ждём вас!' : '.' %>
             Можно изменить ответ в форме ниже.</p>
        </div>
      <% } %>

      <p class="section__lead">Пожалуйста, ответьте до <strong><%= content.rsvpDeadline.dateHuman %></strong>.</p>

      <form class="rsvp-form" method="post" action="/invite/<%= encodeURIComponent(invite.code) %>/rsvp">
        <fieldset class="rsvp-attend">
          <legend>Сможете присоединиться?</legend>
          <label class="choice">
            <input type="radio" name="attending" value="yes"
              <%= invite.attending === true ? 'checked' : '' %> required />
            <span>С радостью буду 🎉</span>
          </label>
          <label class="choice">
            <input type="radio" name="attending" value="no"
              <%= invite.attending === false ? 'checked' : '' %> />
            <span>К сожалению, не смогу</span>
          </label>
        </fieldset>

        <div class="rsvp-details" data-max="<%= invite.maxGuests %>">
          <% if (invite.maxGuests > 1) { %>
            <label class="field">
              <span class="field__label">Сколько вас будет? (максимум <%= invite.maxGuests %>)</span>
              <select name="guestCount" class="field__input">
                <% for (var n = 1; n <= invite.maxGuests; n++) { %>
                  <option value="<%= n %>" <%= (invite.guestCount || 1) === n ? 'selected' : '' %>><%= n %></option>
                <% } %>
              </select>
            </label>
          <% } else { %>
            <input type="hidden" name="guestCount" value="1" />
          <% } %>

          <fieldset class="rsvp-overnight">
            <legend class="field__label"><%= content.rsvp.overnightQuestion %></legend>
            <% content.rsvp.overnightOptions.forEach(function (o) { %>
              <label class="choice choice--sm">
                <input type="radio" name="overnight" value="<%= o.value %>"
                  <%= invite.overnight === o.value ? 'checked' : '' %> required />
                <span><%= o.label %></span>
              </label>
            <% }); %>
          </fieldset>

          <label class="field">
            <span class="field__label">Ограничения в еде / аллергии</span>
            <input type="text" name="dietary" class="field__input"
              maxlength="500" placeholder="Например: вегетарианец, без орехов"
              value="<%= invite.dietary || '' %>" />
          </label>
        </div>

        <label class="field">
          <span class="field__label">Пожелание паре / заявка на песню (необязательно)</span>
          <textarea name="message" class="field__input" rows="3" maxlength="1000"
            placeholder="Пара тёплых слов или любимый трек для танцпола"><%= invite.message || '' %></textarea>
        </label>

        <button type="submit" class="btn btn--primary">Отправить ответ</button>
      </form>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/static/js/countdown.js?v=<%= assetVersion %>" defer></script>
  <script src="/static/js/rsvp.js?v=<%= assetVersion %>" defer></script>
  <% if (content.couple.photoUrl) { %><script src="/static/js/hero-photo.js?v=<%= assetVersion %>" defer></script><% } %>
</body>
</html>
