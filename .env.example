# ── Настройки свадебного сайта ───────────────────────────────────────────────
# Скопируйте этот файл в .env и заполните значения.

# Порт приложения
PORT=3000
NODE_ENV=production

# Публичный адрес сайта (используется для генерации ссылок-приглашений в админке).
# Напр.: https://wedding.example.com
APP_URL=

# Телефоны для связи, показываются в блоке контактов на главной.
# CONTACT_PHONE — первый контакт, CONTACT_PHONE2 — второй.
# Если не задан — контакт выводится без телефона.
CONTACT_PHONE=
CONTACT_PHONE2=

# Пароль для входа в админ-панель (/admin). ОБЯЗАТЕЛЬНО поменяйте!
ADMIN_PASSWORD=change-this-password

# Секрет для подписи сессионных cookie. Задайте длинную случайную строку.
SESSION_SECRET=please-change-to-a-long-random-string

# ── Azure Table Storage ──────────────────────────────────────────────────────
# Если строка подключения не задана, приложение использует локальный файл
# data/invites.json (удобно для разработки; НЕ для продакшена).
#
# Вариант 1: строка подключения целиком
AZURE_STORAGE_CONNECTION_STRING=

# Вариант 2: аккаунт + ключ (если не используете строку подключения выше)
# AZURE_STORAGE_ACCOUNT=youraccount
# AZURE_STORAGE_KEY=your-key

# Имя таблицы (по умолчанию Invites)
AZURE_TABLE_NAME=Invites
