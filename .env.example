# ── Настройки свадебного сайта ───────────────────────────────────────────────
# Скопируйте этот файл в .env и заполните значения.

# Порт приложения
PORT=3000
NODE_ENV=production

# Публичный адрес сайта (используется для генерации ссылок-приглашений в админке).
# Напр.: https://wedding.example.com
APP_URL=

# Телефоны для связи, показываются в блоке контактов на главной.
# CONTACT_PHONE — первый контакт, CONTACT_PHONE2 — второй.
# Если не задан — контакт выводится без телефона.
CONTACT_PHONE=
CONTACT_PHONE2=

# Фото пары в шапке главной страницы и приглашения.
# Нужна прямая ссылка на картинку (заканчивается на .jpg/.png/.webp) —
# страница «поделиться» из Google Photos не подойдёт. Если не задать,
# шапка останется текстовой, как раньше.
# Ссылку видно в HTML любому, у кого есть адрес приглашения.
HERO_PHOTO_URL=

# Какую часть фото показывать при обрезке под вертикальную рамку
# (CSS object-position): center (по умолчанию), top, 'center 30%' и т.п.
# Пригодится, если при обрезке «съедает» лица.
# HERO_PHOTO_POSITION=center

# Фото площадки в секции «Где» на главной. Требования те же,
# что и к HERO_PHOTO_URL: прямая ссылка на картинку. Если не задать, секция
# останется без фото — карточка выводится в одну колонку.
VENUE_PHOTO_URL=

# Пароль для входа в админ-панель (/admin). ОБЯЗАТЕЛЬНО поменяйте!
ADMIN_PASSWORD=change-this-password

# Секрет для подписи сессионных cookie. Задайте длинную случайную строку.
SESSION_SECRET=please-change-to-a-long-random-string

# Флаг Secure у сессионного cookie. По умолчанию включён при NODE_ENV=production.
# Такой cookie браузер отдаёт только по HTTPS — если сайт открыт напрямую по
# http://<ip>:3000, вход в админку будет молча возвращать на форму логина.
# Временное решение до настройки TLS: SESSION_COOKIE_SECURE=false.
# ВНИМАНИЕ: пароль админки при этом идёт по сети открытым текстом.
# SESSION_COOKIE_SECURE=false

# ── Azure Table Storage ──────────────────────────────────────────────────────
# Если строка подключения не задана, приложение использует локальный файл
# data/invites.json (удобно для разработки; НЕ для продакшена).
#
# Вариант 1: строка подключения целиком
AZURE_STORAGE_CONNECTION_STRING=

# Вариант 2: аккаунт + ключ (если не используете строку подключения выше)
# AZURE_STORAGE_ACCOUNT=youraccount
# AZURE_STORAGE_KEY=your-key

# Имя таблицы (по умолчанию Invites)
AZURE_TABLE_NAME=Invites
